PORT=3001
NODE_ENV=development
# 逗号分隔的前端来源白名单
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# 必须以 reading_notes 开头；服务拒绝连接其他库
DB_NAME=reading_notes

# JWT 签名密钥（≥32 字符随机串）。生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
